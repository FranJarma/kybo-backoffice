# Production: PostgreSQL/Neon URL, with TLS according to your provider.
DATABASE_URL=
# Development only: explicit local PGlite directory, never used in production.
KYBO_LOCAL_DB=.local/kybo-db
# At least 32 random bytes, e.g. openssl rand -base64 48. Never commit the value.
BETTER_AUTH_SECRET=
# Public canonical origin of this deployment, e.g. https://operations.example.com
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated exact additional origins if needed. Leave unset otherwise.
BETTER_AUTH_TRUSTED_ORIGINS=
# One-time CLI input only; remove after running user:create. Avoid shell history.
# KYBO_NEW_USER_PASSWORD=
# Product photos: private Vercel Blob store. Keep tokens server-side only.
# Configure these in deployment settings; never use NEXT_PUBLIC_ for credentials.
# Local development may use a separate test Blob store token.
BLOB_READ_WRITE_TOKEN=
# OIDC-backed deployments may use the store ID instead of a static token.
BLOB_STORE_ID=
# Optional server-side Photon endpoint for branch-address lookup (HTTPS only).
# Small administrative volume; cached and rate-limited by Kybo.
KYBO_GEOCODER_URL=https://photon.komoot.io/api/

# Password recovery: email only, using a Gmail app password with 2-Step Verification.
# No real sending until explicitly enabled and recipient addresses confirmed.
KYBO_EMAIL_RECOVERY_ENABLED=false
KYBO_GMAIL_USER=
KYBO_GMAIL_APP_PASSWORD=
# Legacy WhatsApp transport is deferred; the public recovery route ignores it.
# Do not use NEXT_PUBLIC_ for any of these values. Never copy real credentials here.
KYBO_WHATSAPP_RECOVERY_ENABLED=false
# Independent random secret for recovery, at least 32 characters. Do not reuse BETTER_AUTH_SECRET.
KYBO_PASSWORD_RECOVERY_SECRET=
KYBO_WHATSAPP_ACCESS_TOKEN=
# Meta's numeric phone-number ID, not the business phone number.
KYBO_WHATSAPP_PHONE_NUMBER_ID=
# Explicit supported Graph API version selected in Meta, e.g. vNN.N.
KYBO_WHATSAPP_API_VERSION=
# Approved Authentication template with a copy-code button, using the same code.
KYBO_WHATSAPP_AUTH_TEMPLATE=
KYBO_WHATSAPP_TEMPLATE_LANGUAGE=
