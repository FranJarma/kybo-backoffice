# Production: PostgreSQL/Neon URL, with TLS according to your provider.
DATABASE_URL=
# Development only: explicit local PGlite directory, never used in production.
KYBO_LOCAL_DB=.local/kybo-db
# At least 32 random bytes, e.g. openssl rand -base64 48. Never commit the value.
BETTER_AUTH_SECRET=
# Public canonical origin of this deployment, e.g. https://operations.example.com
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated exact additional origins if needed. Leave unset otherwise.
BETTER_AUTH_TRUSTED_ORIGINS=
# One-time CLI input only; remove after running user:create. Avoid shell history.
# KYBO_NEW_USER_PASSWORD=
