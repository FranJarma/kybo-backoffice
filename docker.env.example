# Laboratory only. Copy to docker.env.local; never use production credentials.
# Replace with a random hexadecimal string (64 characters is suitable).
# This value is also embedded in DATABASE_URL, so reserved URL characters are invalid.
KYBO_DOCKER_DB_PASSWORD=replace-with-random-hexadecimal-password
# Generate a separate random secret of at least 32 characters.
KYBO_DOCKER_AUTH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
KYBO_DOCKER_AUTH_URL=http://localhost:3000
# Optional dedicated test-store token; product photos otherwise remain unconfigured.
KYBO_DOCKER_BLOB_TOKEN=
